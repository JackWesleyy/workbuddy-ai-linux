--- a/lib-linux-patches.sh
+++ b/lib-linux-patches.sh
@@ -31,7 +31,7 @@
 #   and shipped inside the generated .deb/.rpm/.pkg.tar.zst under
 #   /opt/<app>/.workbuddy-linux/).
 
-LINUX_PATCHES_SHIM_MARKER="__WB_LINUX_PATCHES_V5__"
+LINUX_PATCHES_SHIM_MARKER="__WB_LINUX_PATCHES_V6__"
 
 apply_linux_runtime_patches() {
     local app_dir="$1"
@@ -69,5 +69,17 @@ apply_linux_runtime_patches() {
         warn "  Failed to apply Linux patches; leaving app.asar untouched"
         return 0
     }
+    # WorkBuddy 5.8.4 uses a Tencent-only Electron binding for its at-rest
+    # key. The standard Linux Electron runtime has no such binding. Ship the
+    # Secret-Service-backed adapter beside the ASAR; it never writes the clear
+    # key to disk.
+    local credential_shim_source="$SCRIPT_DIR/lib-linux-credential-material.js"
+    local credential_shim_target="$app_dir/resources/app.asar.unpacked/main/linux-credential-material.js"
+    [ -f "$credential_shim_source" ] || {
+        warn "  Linux credential shim missing: $credential_shim_source"
+        return 0
+    }
+    mkdir -p "$(dirname "$credential_shim_target")"
+    install -m 0644 "$credential_shim_source" "$credential_shim_target"
     info "  Linux runtime patches applied successfully"
 }
diff --git a/lib-apply-linux-patches.js b/lib-apply-linux-patches.js
index c567b9c..b8d441c 100644
--- a/lib-apply-linux-patches.js
+++ b/lib-apply-linux-patches.js
@@ -632,6 +632,43 @@ if (source.includes(marker)) {
     log('patched main/index.js (env shim + tray context menu + tray icon path + disabled updater)');
 }
 
+// WorkBuddy 5.8.4 calls a Tencent-only Electron binding to retrieve its
+// at-rest key payload. The standard Linux Electron runtime has no such API.
+// Preserve the product's fields encryption policy and provide a Linux
+// implementation backed by safeStorage (the launcher selects Secret Service).
+// Electron only makes safeStorage available after app.whenReady(), so move
+// this bootstrap block to immediately after the existing readiness await.
+const credentialGetter = 'wrapStorageBootstrapLoggerGet(()=>electron.workbuddyStorage.loggerGet())';
+const credentialGetterLinux = 'wrapStorageBootstrapLoggerGet(()=>require(require("path").join(process.resourcesPath,"app.asar.unpacked","main","linux-credential-material.js")).loggerGet(electron,require_workbuddy_paths.s()))';
+if (!source.includes('__WB_LINUX_CREDENTIAL_BOOTSTRAP_V1__')) {
+    if (!source.includes(credentialGetter)) {
+        console.error('[apply-linux-patches] ERROR: WorkBuddy credential getter anchor not found');
+        process.exit(5);
+    }
+    source = '/* __WB_LINUX_CREDENTIAL_BOOTSTRAP_V1__ */\n' + source.replace(credentialGetter, credentialGetterLinux);
+    const bootstrapStart = source.indexOf('this.credentialProtectionBootstrap=loadMainCredentialProtectionBootstrap(');
+    const quitHook = 'electron.app.once(' + String.fromCharCode(96) + 'will-quit' +
+        String.fromCharCode(96) + ',()=>disposeWecomAgentConfirmService()),';
+    const bootstrapEnd = bootstrapStart >= 0 ? source.indexOf(quitHook, bootstrapStart) : -1;
+    if (bootstrapStart < 0 || bootstrapEnd < 0) {
+        console.error('[apply-linux-patches] ERROR: credential bootstrap block boundary not found');
+        process.exit(5);
+    }
+    const bootstrapBlockEnd = bootstrapEnd + quitHook.length;
+    const bootstrapBlock = source.slice(bootstrapStart, bootstrapBlockEnd);
+    source = source.slice(0, bootstrapStart) + source.slice(bootstrapBlockEnd);
+    const mainMethod = source.indexOf('async main(){');
+    const readyAwait = mainMethod >= 0 ? source.indexOf('await electron.app.whenReady(),', mainMethod) : -1;
+    if (readyAwait < 0) {
+        console.error('[apply-linux-patches] ERROR: app.whenReady anchor not found for credential bootstrap');
+        process.exit(5);
+    }
+    const readyAwaitEnd = readyAwait + 'await electron.app.whenReady(),'.length;
+    source = source.slice(0, readyAwaitEnd) + bootstrapBlock + source.slice(readyAwaitEnd);
+    log('patched WorkBuddy credential bootstrap with Secret Service safeStorage after app.whenReady');
+}
+fs.writeFileSync(indexPath, source);
+
 // ---------------------------------------------------------------------------
 // Also patch sidecar-entry.js so the sidecar process, spawned with
 // ELECTRON_RUN_AS_NODE=1 and its own Node bootstrap, receives the same
diff --git a/lib-linux-credential-material.js b/lib-linux-credential-material.js
new file mode 100644
index 0000000..0000000
--- /dev/null
+++ b/lib-linux-credential-material.js
@@ -0,0 +1,155 @@
+'use strict';
+
+const crypto = require('node:crypto');
+const fs = require('node:fs');
+const path = require('node:path');
+
+const DIRECTORY_NAME = 'linux-credential-protection';
+const FILE_NAME = 'field-key.v1.enc';
+const ALLOWED_BACKENDS = new Set([
+  'gnome_libsecret',
+  'kwallet',
+  'kwallet5',
+  'kwallet6',
+]);
+
+function validatePayload(serialized) {
+  let payload;
+  try {
+    payload = JSON.parse(serialized);
+  } catch {
+    throw new Error('Existing Linux credential protection material is invalid; refusing to replace it');
+  }
+
+  if (!payload || payload.version !== 1 || typeof payload.atRestSecretKey !== 'string' ||
+      Object.keys(payload).some((key) => key !== 'version' && key !== 'atRestSecretKey')) {
+    throw new Error('Existing Linux credential protection material has an unsupported format; refusing to replace it');
+  }
+
+  const key = Buffer.from(payload.atRestSecretKey, 'base64');
+  try {
+    if (key.length !== 32 || key.toString('base64') !== payload.atRestSecretKey ||
+        key.every((byte) => byte === 0)) {
+      throw new Error('Existing Linux credential protection material is invalid; refusing to replace it');
+    }
+  } finally {
+    key.fill(0);
+  }
+
+  return JSON.stringify({ version: 1, atRestSecretKey: payload.atRestSecretKey });
+}
+
+function readExistingKey(filePath, safeStorage) {
+  const stat = fs.lstatSync(filePath);
+  if (!stat.isFile() || stat.isSymbolicLink() || (stat.mode & 0o077) !== 0) {
+    throw new Error('Linux credential protection material must be a private regular file');
+  }
+
+  try {
+    return validatePayload(safeStorage.decryptString(fs.readFileSync(filePath)));
+  } catch {
+    throw new Error('Linux credential protection material cannot be unlocked; refusing to replace it');
+  }
+}
+
+function ensurePrivateDirectory(directory) {
+  let existed = true;
+  try {
+    fs.lstatSync(directory);
+  } catch (error) {
+    if (error.code !== 'ENOENT') throw error;
+    existed = false;
+  }
+
+  if (!existed) fs.mkdirSync(directory, { recursive: true, mode: 0o700 });
+  const stat = fs.lstatSync(directory);
+  if (!stat.isDirectory() || stat.isSymbolicLink()) {
+    throw new Error('Linux credential protection directory is not a regular directory');
+  }
+  if ((stat.mode & 0o077) !== 0) {
+    if (existed) throw new Error('Linux credential protection directory permissions are too broad');
+    fs.chmodSync(directory, 0o700);
+  }
+}
+
+function createEncryptedKey(filePath, safeStorage) {
+  const rawKey = crypto.randomBytes(32);
+  let payload;
+  let encrypted;
+  try {
+    payload = JSON.stringify({ version: 1, atRestSecretKey: rawKey.toString('base64') });
+    encrypted = safeStorage.encryptString(payload);
+  } finally {
+    rawKey.fill(0);
+  }
+
+  const tempPath = filePath + '.' + process.pid + '.' + crypto.randomBytes(8).toString('hex') + '.tmp';
+  let fd;
+  try {
+    fd = fs.openSync(tempPath, 'wx', 0o600);
+    fs.writeFileSync(fd, encrypted);
+    fs.fsyncSync(fd);
+  } finally {
+    if (fd !== undefined) fs.closeSync(fd);
+  }
+
+  try {
+    // Atomic and no-clobber, including when two first launches race.
+    fs.linkSync(tempPath, filePath);
+  } catch (error) {
+    if (error.code !== 'EEXIST') throw error;
+  } finally {
+    try {
+      fs.unlinkSync(tempPath);
+    } catch (error) {
+      if (error.code !== 'ENOENT') throw error;
+    }
+  }
+}
+
+function linuxCredentialMaterial(electron, configDir) {
+  const safeStorage = electron?.safeStorage;
+  if (!electron?.app?.isReady?.()) {
+    throw new Error('Electron safeStorage is unavailable before the application is ready');
+  }
+  if (!safeStorage || typeof safeStorage.isEncryptionAvailable !== 'function' ||
+      typeof safeStorage.encryptString !== 'function' ||
+      typeof safeStorage.decryptString !== 'function' ||
+      typeof safeStorage.getSelectedStorageBackend !== 'function') {
+    throw new Error('Electron safeStorage APIs required for Linux credential protection are unavailable');
+  }
+
+  const backend = safeStorage.getSelectedStorageBackend();
+  if (!ALLOWED_BACKENDS.has(backend) || !safeStorage.isEncryptionAvailable()) {
+    throw new Error('A supported GNOME Keyring or KWallet secret store is required for Linux credential protection');
+  }
+  if (typeof configDir !== 'string' || !path.isAbsolute(configDir)) {
+    throw new Error('WorkBuddy credential configuration directory is unavailable');
+  }
+
+  const directory = path.join(configDir, DIRECTORY_NAME);
+  ensurePrivateDirectory(directory);
+  const filePath = path.join(directory, FILE_NAME);
+
+  try {
+    return readExistingKey(filePath, safeStorage);
+  } catch (error) {
+    if (error.code !== 'ENOENT') throw error;
+  }
+
+  createEncryptedKey(filePath, safeStorage);
+  return readExistingKey(filePath, safeStorage);
+}
+
+function loggerGet(electron, configDir) {
+  const nativeLoggerGet = electron?.workbuddyStorage?.loggerGet;
+  if (typeof nativeLoggerGet === 'function') {
+    return nativeLoggerGet.call(electron.workbuddyStorage);
+  }
+  if (process.platform !== 'linux') {
+    throw new Error('The WorkBuddy Electron storage binding is unavailable');
+  }
+  return linuxCredentialMaterial(electron, configDir);
+}
+
+module.exports = { loggerGet };
