+// New WorkBuddy releases put thousands of partial assets directly under
+// renderer/assets. An explicit brace list exceeds minimatch's 64 KiB limit.
+// Replace a dense direct-child list with a directory wildcard instead. The
+// generated sidecar is merged below so additional direct children stay present.
+const partialByParent = new Map();
+for (const file of partialUnpackedFiles) {
+    const parent = path.posix.dirname(file);
+    if (!partialByParent.has(parent)) partialByParent.set(parent, []);
+    partialByParent.get(parent).push(file);
+}
+const bulkPartialDirs = [];
+for (const [parent, files] of partialByParent) {
+    if (parent !== '.' && files.length >= 128 && files.every(file => path.posix.dirname(file) === parent)) {
+        bulkPartialDirs.push(parent);
+    }
+}
+const retainedPartialFiles = partialUnpackedFiles.filter(file =>
+    !bulkPartialDirs.some(dir => path.posix.dirname(file) === dir)
+);
+log('Partially-unpacked files: ' + partialUnpackedFiles.length +
+    ' (' + retainedPartialFiles.length + ' exact, ' + bulkPartialDirs.length + ' parent globs)');
+
+const escapeGlob = value => value.replace(/[{}(),*?[\]!|+@\\]/g, ch => '\\' + ch);
+
+// unpackDir is matched against paths relative to tmpDir. The ASAR library's
+// `unpack` matcher receives the absolute filename, so anchor exact paths and
+// compact parent globs at tmpDir (relative patterns silently match nothing in
+// current @electron/asar releases).
+const unpackDirPattern = '{' + fullyUnpackedDirs.map(escapeGlob).join(',') + '}';
+const unpackTerms = [
+    ...bulkPartialDirs.map(dir => escapeGlob(dir) + '/*'),
+    ...retainedPartialFiles.map(escapeGlob),
+];
+const unpackPattern = unpackTerms.length
+    ? escapeGlob(tmpDir) + '/{' + unpackTerms.join(',') + '}'
     : undefined;
 
